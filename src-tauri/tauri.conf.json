{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Roam Bar",
  "version": "0.1.4",
  "identifier": "com.realbrokerage.roambar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Roam Bar",
        "width": 400,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNTcyOUYwMkQzRTU1MTgKUldRWVZUNHQ4Q2xYR3ErU2I2NXBOS3NDeC9kUUxKNHNTKyszZHliQzZ4dTNRNTRsaEFkcHNkVEcK",
      "endpoints": [
        "https://github.com/abdulwasey/roam-bar/releases/latest/download/latest.json"
      ]
    }
  }
}
